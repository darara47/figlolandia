{
  "name": "figlolandia",
  "version": "1.0.0",
  "private": true,
  "author": "",
  "license": "ISC",
  "scripts": {
    "dev": "pnpm --parallel -r dev",
    "build": "pnpm -r --sort build",
    "start:prod": "pnpm --filter ./apps/backend start:prod",
    "prod": "pnpm build && pnpm start:prod",
    "prod:split": "pnpm build && pnpm --parallel --filter ./apps/backend --filter ./apps/frontend start:prod",
    "fe": "pnpm --filter ./apps/frontend start",
    "fe:web": "pnpm --filter ./apps/frontend web",
    "be": "pnpm --filter ./apps/backend start:dev",
    "host:start": "powershell -NoProfile -ExecutionPolicy Bypass -File ./deploy/windows/start.ps1",
    "host:stop": "powershell -NoProfile -ExecutionPolicy Bypass -File ./deploy/windows/stop.ps1",
    "host:restart": "powershell -NoProfile -ExecutionPolicy Bypass -File ./deploy/windows/restart.ps1",
    "host:status": "powershell -NoProfile -ExecutionPolicy Bypass -File ./deploy/windows/status.ps1",
    "host:update": "powershell -NoProfile -ExecutionPolicy Bypass -File ./deploy/windows/update.ps1",
    "audit:smoke": "node tools/audit-smoke.cjs",
    "audit:benchmark": "node tools/audit-benchmark.cjs",
    "audit:golden": "node tools/golden-games-run.cjs"
  },
  "packageManager": "pnpm@11.10.0"
}