run ubuntu

wsl -d Ubuntu



# Produkcja (jeden port: API + Expo web z dist)

pnpm prod

# → build: game-core + backend dist + frontend dist (expo export --platform web)

# → start: backend node dist/main serwuje też apps/frontend/dist



# Tylko build

pnpm build



# Tylko start z dist (wymaga wcześniejszego build)

pnpm start:prod



# Dwa porty: backend :3008 + frontend :8081 (osobne serwery)

pnpm prod:split



# Dev

pnpm dev          # front + back + game-core watch

pnpm fe:web       # tylko expo web dev

pnpm be           # tylko backend watch



# Windows host — sterowanie stagingiem w WSL (repo: ~/apps/figlolandia)

pnpm host:start

pnpm host:stop

pnpm host:restart

pnpm host:status

pnpm host:update   # git pull + install + build + pm2 restart figlolandia



